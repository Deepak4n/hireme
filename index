<script>
// Skills data
const skills = [
  'Power BI','Python','Microsoft Excel','Excel VBA',
  'Pandas','Data Analytics','Business Intelligence','Data Visualization',
  'Dashboard Design','ETL Pipelines','DAX','SQL',
  'KPI Reporting','Data Modelling','Anaconda','Quality Assurance',
  'Process Automation','Stakeholder Management','Agile / Scrum','KYC Compliance',
  'Reporting & Analytics','Data Cleaning'
];

const grid = document.getElementById('skills-grid');
skills.forEach((s, i) => {
  const el = document.createElement('div');
  el.className = 'skill-pill';
  el.style.transitionDelay = `${i * 0.04}s`;
  el.innerHTML = `<div class="skill-dot"></div><div class="skill-name">${s}</div>`;
  grid.appendChild(el);
});

// Intersection Observer for reveal animations
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

document.querySelectorAll('.reveal, .exp-item, .project-card, .cert-card, .skill-pill').forEach(el => {
  observer.observe(el);
});

// Stagger project cards
document.querySelectorAll('.project-card').forEach((el, i) => {
  el.style.transitionDelay = `${i * 0.1}s`;
});
document.querySelectorAll('.cert-card').forEach((el, i) => {
  el.style.transitionDelay = `${i * 0.08}s`;
});
document.querySelectorAll('.exp-item').forEach((el, i) => {
  el.style.transitionDelay = `${i * 0.15}s`;
});

// Custom cursor
const cursor = document.getElementById('cursor');
const ring = document.getElementById('cursor-ring');
let mx = 0, my = 0, rx = 0, ry = 0;

document.addEventListener('mousemove', e => {
  mx = e.clientX; my = e.clientY;
  cursor.style.left = mx + 'px';
  cursor.style.top = my + 'px';
});

function animateRing() {
  rx += (mx - rx) * 0.12;
  ry += (my - ry) * 0.12;
  ring.style.left = rx + 'px';
  ring.style.top = ry + 'px';
  requestAnimationFrame(animateRing);
}
animateRing();

document.querySelectorAll('a, button, .tool-card, .project-card, .skill-pill').forEach(el => {
  el.addEventListener('mouseenter', () => document.body.classList.add('hovering'));
  el.addEventListener('mouseleave', () => document.body.classList.remove('hovering'));
});

// Typewriter for hero role
const phrases = [
  'Business Intelligence Specialist',
  'Power BI Developer',
  'Python Data Analyst',
  'Dashboard Architect',
  'Data Pipeline Engineer'
];
let pi = 0, ci = 0, deleting = false;
const target = document.querySelector('.hero-role');
if (target) {
  const base = 'Turning data into <span class="highlight">decisions</span> — ';
  function type() {
    const phrase = phrases[pi];
    if (!deleting) {
      ci++;
      target.innerHTML = base + '<span class="typewriter">' + phrase.substring(0, ci) + '</span>';
      if (ci === phrase.length) { deleting = true; setTimeout(type, 1800); return; }
    } else {
      ci--;
      target.innerHTML = base + '<span class="typewriter">' + phrase.substring(0, ci) + '</span>';
      if (ci === 0) { deleting = false; pi = (pi + 1) % phrases.length; setTimeout(type, 300); return; }
    }
    setTimeout(type, deleting ? 40 : 80);
  }
  setTimeout(type, 1400);
}

// Active nav link on scroll
const sections = document.querySelectorAll('section[id]');
const navLinks = document.querySelectorAll('.nav-links a');
window.addEventListener('scroll', () => {
  const scrollY = window.scrollY + 120;
  sections.forEach(sec => {
    if (scrollY >= sec.offsetTop && scrollY < sec.offsetTop + sec.offsetHeight) {
      navLinks.forEach(a => {
        a.style.color = '';
        if (a.getAttribute('href') === '#' + sec.id) a.style.color = 'var(--teal)';
      });
    }
  });
  // Nav background on scroll
  document.querySelector('nav').style.background =
    window.scrollY > 60
      ? 'rgba(8,12,20,0.97)'
      : 'linear-gradient(to bottom, rgba(8,12,20,0.95) 0%, transparent 100%)';
});
</script>

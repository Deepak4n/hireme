<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Dipak Mohite — BI Specialist & Data Analyst</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
:root {
  --bg: #080c14;
  --bg2: #0d1220;
  --bg3: #111827;
  --card: #0f1523;
  --border: rgba(255,255,255,0.07);
  --border-bright: rgba(99,211,200,0.3);
  --teal: #63d3c8;
  --teal2: #3db8ad;
  --amber: #f5a623;
  --amber2: #e8940f;
  --purple: #a78bfa;
  --text: #e8eaf0;
  --text2: #8892a4;
  --text3: #545f73;
  --white: #ffffff;
  --font-display: 'Syne', sans-serif;
  --font-body: 'DM Sans', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.7;
  overflow-x: hidden;
  cursor: none;
}

/* CUSTOM CURSOR */
#cursor {
  width: 10px; height: 10px;
  background: var(--teal);
  border-radius: 50%;
  position: fixed; top: 0; left: 0;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  transition: transform 0.1s, width 0.2s, height 0.2s, background 0.2s;
  mix-blend-mode: screen;
}
#cursor-ring {
  width: 36px; height: 36px;
  border: 1.5px solid rgba(99,211,200,0.5);
  border-radius: 50%;
  position: fixed; top: 0; left: 0;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%, -50%);
  transition: transform 0.12s ease, width 0.25s, height 0.25s, border-color 0.2s;
}
body.hovering #cursor { width: 16px; height: 16px; background: var(--amber); }
body.hovering #cursor-ring { width: 56px; height: 56px; border-color: rgba(245,166,35,0.4); }

/* NOISE OVERLAY */
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
  opacity: 0.025;
  pointer-events: none;
  z-index: 1000;
}

/* GRID PATTERN */
body::after {
  content: '';
  position: fixed; inset: 0;
  background-image: linear-gradient(rgba(99,211,200,0.03) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(99,211,200,0.03) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none;
  z-index: 0;
}

/* NAV */
nav {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 20px 5%;
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(to bottom, rgba(8,12,20,0.95) 0%, transparent 100%);
  backdrop-filter: blur(10px);
}
.nav-logo {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.1rem;
  letter-spacing: -0.02em;
  color: var(--white);
}
.nav-logo span { color: var(--teal); }
.nav-links { display: flex; gap: 32px; list-style: none; }
.nav-links a {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--text2);
  text-decoration: none;
  transition: color 0.2s;
  letter-spacing: 0.05em;
}
.nav-links a:hover { color: var(--teal); }
.nav-cta {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--teal);
  border: 1px solid rgba(99,211,200,0.3);
  padding: 8px 20px;
  border-radius: 4px;
  text-decoration: none;
  transition: all 0.2s;
  letter-spacing: 0.05em;
}
.nav-cta:hover {
  background: rgba(99,211,200,0.08);
  border-color: var(--teal);
}

/* SECTIONS */
section { position: relative; z-index: 1; }

/* HERO */
#hero {
  min-height: 100vh;
  display: flex; align-items: center;
  padding: 120px 5% 80px;
  overflow: hidden;
}
.hero-glow {
  position: absolute;
  width: 700px; height: 700px;
  background: radial-gradient(circle, rgba(99,211,200,0.06) 0%, transparent 70%);
  top: -100px; right: -100px;
  pointer-events: none;
}
.hero-glow2 {
  position: absolute;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(167,139,250,0.05) 0%, transparent 70%);
  bottom: 0; left: -100px;
  pointer-events: none;
}
.hero-content { max-width: 900px; }
.hero-tag {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--teal);
  letter-spacing: 0.1em;
  margin-bottom: 28px;
  opacity: 0;
  animation: fadeUp 0.8s 0.2s forwards;
}
.hero-tag::before {
  content: '';
  display: inline-block;
  width: 32px; height: 1px;
  background: var(--teal);
}
.hero-name {
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 8vw, 7rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.03em;
  color: var(--white);
  opacity: 0;
  animation: fadeUp 0.8s 0.35s forwards;
}
.hero-name .accent { 
  color: transparent;
  -webkit-text-stroke: 2px var(--teal);
  display: block;
}
.hero-role {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2.5vw, 1.6rem);
  font-weight: 600;
  color: var(--text2);
  margin-top: 16px;
  opacity: 0;
  animation: fadeUp 0.8s 0.5s forwards;
}
.hero-role .highlight { color: var(--amber); }
.hero-desc {
  font-size: 1.05rem;
  color: var(--text2);
  max-width: 560px;
  margin-top: 24px;
  line-height: 1.75;
  opacity: 0;
  animation: fadeUp 0.8s 0.65s forwards;
}
.hero-actions {
  display: flex; gap: 16px; flex-wrap: wrap;
  margin-top: 40px;
  opacity: 0;
  animation: fadeUp 0.8s 0.8s forwards;
}
.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--teal);
  color: var(--bg);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.9rem;
  padding: 14px 32px;
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.25s;
  letter-spacing: 0.02em;
}
.btn-primary:hover {
  background: #7ee8de;
  transform: translateY(-2px);
  box-shadow: 0 12px 40px rgba(99,211,200,0.25);
}
.btn-secondary {
  display: inline-flex; align-items: center; gap: 8px;
  color: var(--text);
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 14px 32px;
  border: 1px solid var(--border);
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.25s;
}
.btn-secondary:hover {
  border-color: rgba(99,211,200,0.4);
  color: var(--teal);
  transform: translateY(-2px);
}
.hero-stats {
  display: flex; gap: 48px; flex-wrap: wrap;
  margin-top: 64px;
  padding-top: 48px;
  border-top: 1px solid var(--border);
  opacity: 0;
  animation: fadeUp 0.8s 1s forwards;
}
.stat-num {
  font-family: var(--font-display);
  font-size: 2.4rem;
  font-weight: 800;
  color: var(--white);
  letter-spacing: -0.03em;
  line-height: 1;
}
.stat-num span { color: var(--teal); }
.stat-label {
  font-size: 0.8rem;
  color: var(--text3);
  margin-top: 4px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-family: var(--font-mono);
}
.hero-scroll {
  position: absolute; bottom: 40px; left: 50%;
  transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  opacity: 0; animation: fadeIn 1s 1.5s forwards;
}
.scroll-line {
  width: 1px; height: 48px;
  background: linear-gradient(to bottom, var(--teal), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
.scroll-text {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--text3);
  letter-spacing: 0.15em;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
}

/* ABOUT */
#about {
  padding: 120px 5%;
}
.section-header {
  display: flex; align-items: center; gap: 16px;
  margin-bottom: 64px;
}
.section-num {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--teal);
  letter-spacing: 0.1em;
}
.section-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  color: var(--white);
  letter-spacing: -0.02em;
}
.section-line {
  flex: 1; height: 1px;
  background: linear-gradient(to right, var(--border-bright), transparent);
  max-width: 300px;
}
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
}
.about-text p {
  color: var(--text2);
  margin-bottom: 20px;
  font-size: 1.05rem;
  line-height: 1.8;
}
.about-text p strong { color: var(--teal); font-weight: 500; }
.about-highlight {
  background: linear-gradient(135deg, rgba(99,211,200,0.06), rgba(167,139,250,0.04));
  border: 1px solid rgba(99,211,200,0.12);
  border-radius: 12px;
  padding: 28px;
  margin-top: 8px;
}
.about-highlight-text {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--white);
  line-height: 1.5;
}
.about-highlight-text em { color: var(--teal); font-style: normal; }
.tools-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
}
.tool-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 18px 20px;
  transition: all 0.3s;
  cursor: default;
}
.tool-card:hover {
  border-color: rgba(99,211,200,0.25);
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}
.tool-icon {
  font-size: 1.4rem;
  margin-bottom: 8px;
}
.tool-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--white);
  margin-bottom: 2px;
}
.tool-desc {
  font-size: 0.78rem;
  color: var(--text3);
  font-family: var(--font-mono);
}

/* EXPERIENCE */
#experience {
  padding: 120px 5%;
  background: linear-gradient(to bottom, transparent, rgba(13,18,32,0.5), transparent);
}
.exp-container { max-width: 900px; margin: 0 auto; }
.exp-item {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 48px;
  padding-bottom: 64px;
  position: relative;
  opacity: 0;
  transform: translateY(30px);
  transition: all 0.6s;
}
.exp-item.visible { opacity: 1; transform: translateY(0); }
.exp-item::after {
  content: '';
  position: absolute;
  left: 215px;
  top: 12px; bottom: 0;
  width: 1px;
  background: linear-gradient(to bottom, var(--teal2), transparent);
  opacity: 0.2;
}
.exp-item:last-child::after { display: none; }
.exp-meta { text-align: right; padding-top: 4px; }
.exp-date {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--teal);
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}
.exp-company {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--text2);
}
.exp-dot {
  position: absolute;
  left: 207px;
  top: 8px;
  width: 14px; height: 14px;
  border-radius: 50%;
  border: 2px solid var(--teal);
  background: var(--bg);
  box-shadow: 0 0 16px rgba(99,211,200,0.3);
}
.exp-body {}
.exp-role {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--white);
  letter-spacing: -0.02em;
  margin-bottom: 12px;
  line-height: 1.2;
}
.exp-desc {
  color: var(--text2);
  font-size: 0.95rem;
  line-height: 1.75;
  margin-bottom: 20px;
}
.exp-bullets { list-style: none; margin-bottom: 20px; }
.exp-bullets li {
  color: var(--text2);
  font-size: 0.92rem;
  line-height: 1.7;
  padding-left: 20px;
  position: relative;
  margin-bottom: 8px;
}
.exp-bullets li::before {
  content: '▹';
  position: absolute; left: 0;
  color: var(--teal);
  font-size: 0.9rem;
}
.exp-tags { display: flex; gap: 8px; flex-wrap: wrap; }
.exp-tag {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--teal);
  background: rgba(99,211,200,0.06);
  border: 1px solid rgba(99,211,200,0.15);
  border-radius: 4px;
  padding: 4px 10px;
  letter-spacing: 0.05em;
}

/* PROJECTS */
#projects { padding: 120px 5%; }
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 24px;
}
.project-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 32px;
  transition: all 0.35s;
  position: relative;
  overflow: hidden;
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.6s, transform 0.6s, border-color 0.3s, box-shadow 0.3s;
}
.project-card.visible { opacity: 1; transform: translateY(0); }
.project-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(99,211,200,0.04), transparent 60%);
  opacity: 0;
  transition: opacity 0.3s;
}
.project-card:hover::before { opacity: 1; }
.project-card:hover {
  border-color: rgba(99,211,200,0.2);
  box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  transform: translateY(-4px);
}
.project-num {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text3);
  letter-spacing: 0.1em;
  margin-bottom: 16px;
}
.project-icon {
  font-size: 2rem;
  margin-bottom: 16px;
}
.project-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--white);
  letter-spacing: -0.02em;
  margin-bottom: 12px;
}
.project-desc {
  font-size: 0.9rem;
  color: var(--text2);
  line-height: 1.7;
  margin-bottom: 20px;
}
.project-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.project-tag {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--amber);
  background: rgba(245,166,35,0.07);
  border: 1px solid rgba(245,166,35,0.15);
  border-radius: 4px;
  padding: 3px 8px;
}

/* SKILLS */
#skills {
  padding: 120px 5%;
  background: linear-gradient(to bottom, transparent, rgba(13,18,32,0.5), transparent);
}
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 12px;
}
.skill-pill {
  display: flex; align-items: center; gap: 10px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px 16px;
  transition: all 0.25s;
  opacity: 0;
  transform: scale(0.95);
}
.skill-pill.visible { opacity: 1; transform: scale(1); }
.skill-pill:hover {
  border-color: rgba(99,211,200,0.25);
  background: rgba(99,211,200,0.04);
  transform: scale(1.02);
}
.skill-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--teal); flex-shrink: 0;
}
.skill-name {
  font-size: 0.85rem;
  color: var(--text);
  font-weight: 400;
}

/* CERTIFICATIONS */
#certifications { padding: 120px 5%; }
.certs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}
.cert-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px;
  display: flex; gap: 16px; align-items: flex-start;
  transition: all 0.3s;
  opacity: 0; transform: translateY(20px);
}
.cert-card.visible { opacity: 1; transform: translateY(0); }
.cert-card:hover {
  border-color: rgba(167,139,250,0.25);
  transform: translateY(-2px);
}
.cert-icon {
  width: 44px; height: 44px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(167,139,250,0.15), rgba(99,211,200,0.1));
  display: flex; align-items: center; justify-content: center;
  font-size: 1.3rem;
  flex-shrink: 0;
}
.cert-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--white);
  margin-bottom: 4px;
  line-height: 1.3;
}
.cert-issuer {
  font-size: 0.78rem;
  color: var(--text3);
  font-family: var(--font-mono);
}

/* EDUCATION */
#education { padding: 80px 5% 120px; }
.edu-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 48px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 32px;
  align-items: start;
  max-width: 800px;
  transition: all 0.3s;
}
.edu-card:hover { border-color: rgba(99,211,200,0.15); }
.edu-degree {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--white);
  letter-spacing: -0.02em;
  margin-bottom: 8px;
}
.edu-school {
  font-size: 1rem;
  color: var(--teal);
  font-weight: 500;
  margin-bottom: 16px;
}
.edu-courses {
  font-size: 0.88rem;
  color: var(--text2);
  line-height: 1.7;
}
.edu-courses strong { color: var(--text); font-weight: 500; }
.edu-year {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text3);
  text-align: right;
  white-space: nowrap;
  padding-top: 6px;
}
.edu-badge {
  display: inline-block;
  margin-top: 12px;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--amber);
  background: rgba(245,166,35,0.08);
  border: 1px solid rgba(245,166,35,0.2);
  border-radius: 4px;
  padding: 4px 10px;
  letter-spacing: 0.05em;
}

/* CONTACT */
#contact {
  padding: 120px 5%;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.contact-glow {
  position: absolute;
  width: 600px; height: 400px;
  background: radial-gradient(ellipse, rgba(99,211,200,0.07) 0%, transparent 70%);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.contact-label {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--teal);
  letter-spacing: 0.15em;
  margin-bottom: 24px;
}
.contact-headline {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 800;
  color: var(--white);
  letter-spacing: -0.03em;
  line-height: 1;
  margin-bottom: 16px;
}
.contact-headline span { color: var(--teal); }
.contact-sub {
  font-size: 1.05rem;
  color: var(--text2);
  max-width: 480px;
  margin: 0 auto 40px;
}
.contact-email {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--teal);
  text-decoration: none;
  border: 1px solid rgba(99,211,200,0.2);
  padding: 18px 40px;
  border-radius: 8px;
  transition: all 0.3s;
  margin-bottom: 40px;
}
.contact-email:hover {
  background: rgba(99,211,200,0.07);
  border-color: var(--teal);
  box-shadow: 0 0 40px rgba(99,211,200,0.12);
  transform: translateY(-2px);
}
.contact-links {
  display: flex; align-items: center; justify-content: center; gap: 24px;
  flex-wrap: wrap;
}
.contact-link {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text3);
  text-decoration: none;
  letter-spacing: 0.05em;
  transition: color 0.2s;
  display: flex; align-items: center; gap: 6px;
}
.contact-link:hover { color: var(--teal); }

